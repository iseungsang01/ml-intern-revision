data/*
!data/splits/
!data/splits/*.csv
!data/splits/*.json
data/.ces_cache/
__pycache__/
**/__pycache__/
ces_prediction/metrics.json
ces_prediction/weights/
ces_prediction/eval_metrics.json
**/.automl_state/
.env

# Agent scratch. Nothing under .omc is an input to a result: the plans and specs that
# used to be tracked here described work that THESIS_RESULTS.md §8 now records as
# outcomes. The **/ form matters -- agent sessions create .omc/ inside subdirectories too.
.omc/
**/.omc/

# presentation layout-QC renders (preview_pptx.py) and stray preview builds
docs/presentation/.preview/
docs/presentation/.preview*/
docs/presentation/.preview_*.pptx
# Office lock files (present while a deck is open in PowerPoint)
~$*

# LaTeX build artifacts. main.pdf IS tracked (it is the deliverable); everything the
# engine regenerates on the way there is not.
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# packaging / build artifacts
*.egg-info/
