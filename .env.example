# Copy this file to .env and fill in real values. .env is gitignored.
# automl_agent_loop.py loads .env automatically at startup (via python-dotenv).

# --- Researcher auth: pick ONE ---

# Option A (default, subscription billing): Claude Code login.
# Token from `claude setup-token` (starts with sk-ant-oat01-...). The researcher
# drives the `claude` CLI with this, so calls bill against your Claude
# subscription, not API credits. Optional if `claude` is already logged in on
# this machine (then the CLI just uses the existing login).
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxx

# Option B (API-credit billing): a REAL API key from https://console.anthropic.com
# -> API Keys (starts with sk-ant-api03-...). If set, the researcher uses the
# Anthropic SDK instead of the CLI. Leave unset to use Option A.
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Slack (required; the loop aborts at startup if these are missing) ---
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=your-channel-or-dm-id

# --- Optional: override the researcher model (default: claude-opus-4-8) ---
# AUTOML_RESEARCH_MODEL=claude-opus-4-8
